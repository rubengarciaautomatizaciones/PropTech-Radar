    },
    {
      "page": "/api/webhooks/stripe",
      "regex": "^/api/webhooks/stripe(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/webhooks/stripe(?:/)?$"
    },
    {
      "page": "/api/webhooks/telegram",
      "regex": "^/api/webhooks/telegram(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/webhooks/telegram(?:/)?$"
    },
    {
      "page": "/callback",
      "regex": "^/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/callback(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/billing",
      "regex": "^/dashboard/billing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/billing(?:/)?$"
    },
    {
      "page": "/dashboard/config",
      "regex": "^/dashboard/config(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/config(?:/)?$"
    },
    {
      "page": "/dashboard/team",
      "regex": "^/dashboard/team(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/team(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pricing(?:/)?$"
    },
    {
      "page": "/signup",
