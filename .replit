modules = ["nodejs-24"]

entrypoint = "artifacts/radar-proptech/package.json"

run = "pkill -f 'next dev' || true; cd artifacts/radar-proptech && pnpm install && rm -rf .next && pnpm exec next dev -p 3000"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80
exposeLocalhost = true