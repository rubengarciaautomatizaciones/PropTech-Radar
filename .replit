# .replit - Configuración optimizada para desarrollo en Monorepo

modules = ["nodejs-24"]

entrypoint = "artifacts/radar-proptech/package.json"

# AÑADIMOS -H 0.0.0.0 PARA QUE REPLIT PUEDA CONECTARSE AL SERVIDOR
run = "pkill -f 'next dev' || true; cd artifacts/radar-proptech && pnpm install && rm -rf .next && pnpm exec next dev -H 0.0.0.0 -p 3000"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 19946
externalPort = 3000
